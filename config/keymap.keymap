#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <300>; };

&mt { tapping-term-ms = <300>; };

/ {
    behaviors {
        mouse_lt: mouse_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&mkp>;
            display-name = "Mouse Layer-Tap";
        };
    };

    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 2>;
            key-positions = <20 21>;
        };

        gesture {
            bindings = <&mo 3>;
            key-positions = <8 9>;
        };

        exit_app {
            bindings = <&kp LG(Q)>;
            key-positions = <9 10>;
        };

        log_off {
            bindings = <&kp LG(LC(Q))>;
            key-positions = <47 48>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q         &kp W     &kp E             &kp R                 &kp T        &kp Y        &kp U          &kp I              &kp O           &kp P           &kp TILDE
&kp TAB           &kp A         &kp S     &kp D             &kp F                 &kp G        &kp H        &kp J          &kp K              &kp L           &kp SEMICOLON   &kp MINUS
&kp LSHFT         &kp Z         &kp X     &kp C             &kp V                 &kp B        &kp DELETE   &kp BACKSPACE  &lt 5 N            &lt 3 M         &kp COMMA       &kp DOT          &kp UP_ARROW  &mt RSHFT QUESTION
&kp LEFT_COMMAND  &kp LEFT_ALT  &kp CAPS  &kp LEFT_COMMAND  &mt LCTRL LANGUAGE_2  &lt 4 LANG1  &lt 5 SPACE  &lt 6 ENTER    &kp RIGHT_CONTROL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            display-name = "Mouse";
            bindings = <
&trans            &trans        &trans  &trans            &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
&trans            &trans        &trans  &trans            &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&kp LSHIFT        &trans        &trans  &trans            &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans  &trans  &trans
&kp LEFT_COMMAND  &kp LEFT_ALT  &trans  &kp LEFT_COMMAND  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
            >;
        };

        layer_2 {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            display-name = "Gesture";

            /* Conductor-style editable gesture slots:
             * I = up, J = left, L = right, comma/< = down.
             */

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &kp LC(UP_ARROW)  &trans         &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LEFT_ARROW)  &trans            &kp LC(RIGHT)  &trans              &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans            &trans         &kp LC(DOWN_ARROW)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans            &trans         &trans              &trans
            >;
        };

        layer_4 {
            display-name = "symbol";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN     &kp HASH        &kp DOLLAR     &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp LG(LS(N3))   &kp LG(LS(N4))  &kp LG(LS(N5))  &kp LA(A)      &kp LG(LA(S))  &kp MINUS  &kp EQUAL      &kp SLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&trans  &trans           &trans          &kp LG(LA(C))   &kp LG(LA(V))  &trans         &trans     &trans         &trans     &trans                &kp SEMICOLON          &kp SQT  &kp GRAVE  &trans
&trans  &trans           &trans          &trans          &trans         &trans         &mo 7      &trans         &trans     &trans                &trans                 &trans
            >;
        };

        layer_5 {
            display-name = "number";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS      &kp MINUS  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp N4        &kp NUMBER_5  &kp N6        &kp ASTERISK  &kp SLASH  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans        &kp NUMBER_0  &kp N1        &kp N2        &kp N3     &kp COMMA  &kp EQUAL  &trans
&trans  &trans   &trans   &trans  &trans  &trans   &trans        &kp PERIOD    &trans        &kp COLON     &kp LA(Y)  &trans
            >;
        };

        layer_6 {
            display-name = "move";
            bindings = <
&trans  &trans  &kp LG(NUMBER_0)        &kp LG(MINUS)      &kp LG(PLUS)       &trans  &kp LG(T)  &kp LC(LS(TAB))  &kp UP_ARROW    &kp LC(TAB)         &kp LG(W)      &trans
&trans  &trans  &kp K_MUTE              &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &trans  &kp LC(A)  &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW     &kp LC(E)      &trans
&trans  &trans  &kp LA(LC(LEFT_ARROW))  &kp LA(LC(F))      &kp LA(LC(RIGHT))  &trans  &trans     &kp LG(LS(N))    &kp HOME        &kp LG(LEFT_ARROW)  &kp LG(LA(P))  &kp LG(RIGHT_ARROW)  &kp END  &trans
&trans  &trans  &trans                  &trans             &trans             &trans  &trans     &trans           &trans          &kp LG(R)           &kp LG(LS(H))  &trans
            >;
        };

        layer_7 {
            display-name = "setting";
            bindings = <
&none  &out OUT_BLE  &out OUT_USB  &none  &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none
&none  &none         &none         &none  &none  &none  &none         &none         &none         &none         &none           &none
&none  &none         &none         &none  &none  &none  &bootloader   &bootloader   &none         &none         &none           &none  &none  &none
&none  &none         &none         &none  &none  &none  &none         &none         &none         &bt BT_CLR    &bt BT_CLR_ALL  &none
            >;
        };

        layer_8 {
            display-name = "User 8";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
