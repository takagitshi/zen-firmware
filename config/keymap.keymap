#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp Q         &kp W             &kp E     &kp R    &kp T                   &kp Y             &kp U             &kp I  &kp O           &kp P           &kp BSPC
&kp TAB           &kp A         &kp S             &kp D     &kp F    &kp G                   &kp H             &kp J             &kp K  &kp L           &kp MINUS       &kp ENTER
&kp LSHFT         &kp Z         &kp X             &kp C     &kp V    &kp B                   &to 2             &to 4             &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &mt RSHFT QUESTION
&kp LEFT_COMMAND  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp CAPS  &kp DEL  &mt LEFT_CONTROL SPACE  &lt 2 LANGUAGE_2  &lt 4 LANGUAGE_1  &mo 3  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &to 0     &trans    &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp AT_SIGN    &kp EXCLAMATION       &kp DOUBLE_QUOTES  &kp HASH           &kp DOLLAR            &kp PERCENT            &kp COMMA   &kp N7  &kp N8  &kp N9  &kp PLUS   &kp LA(Y)
&kp AMPERSAND  &kp TILDE             &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERIOD  &kp N4  &kp N5  &kp N6  &kp MINUS  &kp EQUAL
&kp SQT        &kp NON_US_BACKSLASH  &kp LEFT_BRACE     &kp RIGHT_BRACE    &kp LESS_THAN         &kp GREATER_THAN       &trans      &trans  &kp N0  &kp N1  &kp N2     &kp N3     &kp ASTERISK  &kp COLON
&kp PIPE       &kp GRAVE             &kp CARET          &trans             &trans                &trans                 &trans      &trans  &to 0   &trans  &kp SLASH  &trans
            >;
        };

        layer_3 {
            bindings = <
&out OUT_USB    &kp F1        &kp F2        &kp F3         &kp F4         &kp F5   &kp LG(LS(N3))  &kp LS(LG(N4))  &kp LS(LG(N5))  &trans              &trans              &kp LC(LG(Q))
&out OUT_BLE    &kp F6        &kp F7        &kp F8         &kp F9         &kp F10  &kp LA(A)       &kp LA(LG(S))   &kp LA(LG(K))   &trans              &trans              &trans
&bt BT_CLR_ALL  &kp F11       &kp F12       &kp LA(LG(C))  &kp LA(LG(V))  &trans   &trans          &to 0           &trans          &trans              &trans              &trans         &kp LC(UP_ARROW)  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4   &trans   &bt BT_NXT      &to 0           &trans          &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(RIGHT)
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 0   &trans  &trans  &trans
            >;
        };
    };
};
