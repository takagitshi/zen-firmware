#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC       &kp Q         &kp W             &kp E     &kp R                        &kp T                   &kp Y        &kp U          &kp I  &kp O           &kp P           &mo 4
&kp TAB       &kp A         &kp S             &kp D     &kp F                        &kp G                   &kp H        &kp J          &kp K  &kp L           &kp SEMICOLON   &kp MINUS
&kp LSHFT     &kp Z         &kp X             &kp C     &kp V                        &kp B                   &kp DELETE   &kp BACKSPACE  &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &mt RSHFT QUESTION
&kp CAPSLOCK  &kp LEFT_ALT  &kp LEFT_CONTROL  &mkp MB1  &mt LEFT_COMMAND LANGUAGE_2  &mt LEFT_CONTROL LANG1  &lt 2 SPACE  &lt 1 ENTER    &mo 3  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&none  &none  &none  &none  &none  &none  &kp LG(LS(N))  &kp LG(N)  &kp LG(LA(P))  &kp LG(LS(H))     &kp F18          &mo 4
&none  &none  &none  &none  &none  &none  &kp LG(T)      &mkp MB1   &mkp MB3       &mkp MB2          &kp LG(W)        &kp LG(Q)
&none  &none  &none  &none  &none  &none  &none          &to 1      &msc SCRL_UP   &msc SCRL_DOWN    &kp LC(LS(TAB))  &kp LC(TAB)        &kp LC(LA(F))  &kp LC(LA(R))
&none  &none  &none  &none  &none  &none  &none          &trans     &to 0          &kp LC(LA(LEFT))  &kp LC(DOWN)     &kp LC(LA(RIGHT))
            >;
        };

        layer_2 {
            bindings = <
&kp AT_SIGN    &kp EXCLAMATION       &kp DOUBLE_QUOTES  &kp HASH           &kp DOLLAR            &kp PERCENT            &kp COMMA   &kp N7  &kp N8  &kp N9  &kp PLUS   &kp LA(Y)
&kp AMPERSAND  &kp TILDE             &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERIOD  &kp N4  &kp N5  &kp N6  &kp MINUS  &kp EQUAL
&kp SQT        &kp NON_US_BACKSLASH  &kp LEFT_BRACE     &kp RIGHT_BRACE    &kp LESS_THAN         &kp GREATER_THAN       &to 2       &trans  &kp N0  &kp N1  &kp N2     &kp N3     &kp ASTERISK  &kp COLON
&kp PIPE       &kp GRAVE             &kp CARET          &none              &kp C_VOLUME_DOWN     &kp C_VOLUME_UP        &trans      &trans  &to 0   &none   &kp SLASH  &none
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR_ALL  &kp F1        &kp F2        &kp F3         &kp F4         &kp F5      &kp LG(LS(N3))  &kp LS(LG(N4))  &kp LS(LG(N5))  &trans              &trans              &kp LC(LG(Q))
&out OUT_USB    &kp F6        &kp F7        &kp F8         &kp F9         &kp F10     &kp LA(A)       &kp LA(LG(S))   &kp LA(LG(K))   &trans              &trans              &trans
&out OUT_BLE    &kp F11       &kp F12       &kp LA(LG(C))  &kp LA(LG(V))  &none       &trans          &trans          &trans          &trans              &trans              &trans         &kp LC(UP_ARROW)  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_NXT  &trans          &trans          &to 0           &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(RIGHT)
            >;
        };

        layer_4 {
            bindings = <
&none  &kp F1   &kp F2   &kp F3  &kp F4          &kp F5           &kp LG(LS(N))  &kp LG(N)  &kp LG(LA(P))  &kp LG(LS(H))     &kp F18          &kp LG(R)
&none  &kp F6   &kp F7   &kp F8  &kp F9          &kp F10          &kp LG(T)      &mkp MB1   &mkp MB3       &mkp MB2          &kp LG(W)        &kp LG(Q)
&none  &kp F11  &kp F12  &none   &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans         &trans     &msc SCRL_UP   &msc SCRL_DOWN    &kp LC(LS(TAB))  &kp LC(TAB)        &kp LC(LA(F))  &kp LC(LA(R))
&none  &none    &none    &none   &none           &none            &trans         &trans     &to 0          &kp LA(LC(LEFT))  &kp LG(DOWN)     &kp LG(LA(RIGHT))
            >;
        };
    };
};
